# Normalize all text files to LF
* text=auto eol=lf

# C/C++ source
*.c       text eol=lf
*.h       text eol=lf
*.cc      text eol=lf
*.cpp     text eol=lf
*.cxx     text eol=lf
*.hh      text eol=lf
*.hpp     text eol=lf
*.hxx     text eol=lf

# Build / configuration
*.cmake    text eol=lf
CMakeLists.txt text eol=lf
*.json     text eol=lf
*.yaml     text eol=lf
*.yml      text eol=lf
*.toml     text eol=lf
*.ini      text eol=lf
*.cfg      text eol=lf
*.conf     text eol=lf

# Documentation / text / data
*.txt      text eol=lf
*.md       text eol=lf
*.csv      text eol=lf
*.xml      text eol=lf
*.glsl     text eol=lf
*.cl       text eol=lf
*.shader   text eol=lf

# Scripts
*.sh       text eol=lf
*.bat      text eol=lf
*.cmd      text eol=lf
*.ps1      text eol=lf

# GitHub Actions
.github/**/*.yml text eol=lf
.github/**/*.yaml text eol=lf

# Binary files
*.exe      binary
*.dll      binary
*.lib      binary
*.a        binary
*.obj      binary
*.o        binary
*.pdb      binary
*.ilk       binary
*.zip      binary
*.7z       binary
*.tar      binary
*.gz       binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.bmp      binary
*.ico      binary